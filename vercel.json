{
  "buildCommand": "node build-runner.mjs && node scripts/apply-privacy-policy.mjs",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://elfsightcdn.com https://www.googletagmanager.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://xwihrxinweeadtcouhoo.supabase.co https://www.google-analytics.com https://www.google.com https://*.google.com; frame-src 'self' https://www.google.com https://*.google.com https://*.elfsight.com; object-src 'none'; base-uri 'self'; form-action 'self' https://wa.me;"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/paciente/diario/anna",
      "destination": "/api/patient-page-proxy?app=anna-diario"
    },
    {
      "source": "/paciente/diario/anna/:path*",
      "destination": "/api/patient-page-proxy?app=anna-diario&path=:path*"
    },
    {
      "source": "/paciente/hiit/anna",
      "destination": "/api/patient-page-proxy?app=anna-hiit"
    },
    {
      "source": "/paciente/hiit/anna/:path*",
      "destination": "/api/patient-page-proxy?app=anna-hiit&path=:path*"
    },
    {
      "source": "/paciente/treinos/anna",
      "destination": "/api/patient-page-proxy?app=anna-treino"
    },
    {
      "source": "/paciente/treinos/anna/:path*",
      "destination": "/api/patient-page-proxy?app=anna-treino&path=:path*"
    },
    {
      "source": "/paciente/treinos/isabel-maratona",
      "destination": "/api/patient-page-proxy?app=isabel-maratona"
    },
    {
      "source": "/paciente/treinos/isabel-maratona/:path*",
      "destination": "/api/patient-page-proxy?app=isabel-maratona&path=:path*"
    },
    {
      "source": "/paciente/diario/vinicius",
      "destination": "/api/patient-page-proxy?app=vinicius-diario"
    },
    {
      "source": "/paciente/diario/vinicius/:path*",
      "destination": "/api/patient-page-proxy?app=vinicius-diario&path=:path*"
    },
    {
      "source": "/paciente",
      "destination": "https://admin.nutrithales.com.br/paciente"
    },
    {
      "source": "/paciente/:path*",
      "destination": "https://admin.nutrithales.com.br/paciente/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://admin.nutrithales.com.br/_next/:path*"
    }
  ]
}
